[Unit]
Description=NengTan Standard KubeEdge DMI Modbus Mapper
# nengtan-chirpstack：LoRa 设备订阅盒内 ChirpStack 的 MQTT(127.0.0.1:41884)，
# 必须在 docker compose 容器起来之后再启动，否则冷启动时订阅失败、LoRa 设备无数据。
After=network.target edgecore.service nengtan-chirpstack.service
Wants=nengtan-chirpstack.service

[Service]
# DMI twin 上报节流（点位级消息会打满 edgecore 通道，见 box_mapper.py 中 DMI_MIN_INTERVAL）
Environment=DMI_MIN_INTERVAL=15
ExecStart=/usr/bin/python3 -u /opt/weight-bridge/dmi/box_mapper.py
Restart=always
RestartSec=5
WorkingDirectory=/opt/weight-bridge/dmi

[Install]
WantedBy=multi-user.target

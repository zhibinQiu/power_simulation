# ===== 依赖 / 构建产物 =====
node_modules/
frontend/node_modules/
frontend/dist/
*.egg-info/

# ===== PyInstaller 打包产物 =====
dist/
build/
*.spec
SteelCarbonTwin.spec

# ===== Python 运行残留 =====
__pycache__/
*.pyc
*.pyo
backend/**/__pycache__/

# ===== 前端 Vite 构建临时配置（vite.config.js.timestamp-*.mjs） =====
frontend/vite.config.js.timestamp-*.mjs

# ===== 临时/调试脚本 =====
frontend/_rtest5.mjs
frontend/tft_verify.mjs
frontend/.serve_check.mjs
backend/1necho

# ===== 运行日志 =====
*.log
backend/server*.log

# ===== 行情快照（运行时缓存，不进版本库） =====
backend/data/market_snapshot.json
backend/data/market_snapshot.json.tmp

# ===== box_console 运行时生成的 onboard 脚本 =====
backend/generated/

# ===== 本地配置覆盖（按需自行保留，统一位于 backend/config/） =====
backend/config/platform_config.json
backend/config/strategies.json
backend/config/.env
# GitHub 托管配置（含个人访问令牌 PAT，勿提交版本库）
backend/config/github_config.json

# ===== macOS / 浏览器调试残留 =====
.DS_Store
.playwright-cli/

# ===== 内部工具状态（助手记忆等，非项目源码，不进版本库） =====
.workbuddy/

# ===== 图片/截图类中间产物（如需纳入版本管理请移除对应行） =====
*.png
!frontend/public/**/*.png
!icon.png
!platform/icon.ico

# ===== 前端/文档站构建产物入库（源码卷挂载模式）=====
# 上方 `dist/` 通配会忽略任意层级 dist 目录，故用 ! 逐级恢复并入库：
# 全新 git 部署开箱即有前端/文档站产物（Dockerfile 均 COPY dist，无需 node 构建）
!frontend/dist/
!frontend/dist/**
!docs-site/dist/
!docs-site/dist/**

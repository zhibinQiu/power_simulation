# ===== 依赖 / 构建产物 =====
node_modules/
frontend/node_modules/
frontend/dist/
*.egg-info/

# ===== PyInstaller 打包产物 =====
dist/
build/
*.spec
SteelCarbonTwin.spec

# ===== Python 运行残留 =====
__pycache__/
*.pyc
*.pyo
backend/**/__pycache__/

# ===== 前端/文档站 Vite 构建临时配置（vite.config.js.timestamp-*.mjs） =====
frontend/vite.config.js.timestamp-*.mjs
platform/doc-deploy/docs-site/vite.config.js.timestamp-*.mjs

# ===== 门户/文档站本地静态服务运行时残留（serve.sh） =====
platform/portal-deploy/.serve.pid
platform/portal-deploy/.serve.log

# ===== 临时/调试脚本 =====
frontend/_rtest5.mjs
frontend/tft_verify.mjs
frontend/.serve_check.mjs
backend/1necho

# ===== 运行日志 =====
*.log
backend/server*.log

# ===== 行情快照（运行时缓存，不进版本库） =====
backend/data/market_snapshot.json
backend/data/market_snapshot.json.tmp
# ===== 辨识脚本运行产物（backend/tools/*_ident.py 输出） =====
tec_prbs_run.csv
# ===== 编排方案服务端存档（流程编排 / AI 群控，运行期生成：随 platform/update.sh bs 同步） =====
backend/data/designs/

# ===== box_console 运行时生成的 onboard 脚本 =====
backend/generated/

# ===== 本地配置覆盖（按需自行保留，统一位于 backend/config/） =====
backend/config/platform_config.json
backend/config/strategies.json
backend/config/.env
# GitHub 托管配置（含个人访问令牌 PAT，勿提交版本库）
backend/config/github_config.json

# ===== macOS / 浏览器调试残留 =====
.DS_Store
.playwright-cli/

# ===== 内部工具状态（助手记忆等，非项目源码，不进版本库） =====
.workbuddy/

# ===== 图片/截图类中间产物（如需纳入版本管理请移除对应行） =====
*.png
!frontend/public/**/*.png
!icon.png
!platform/icon.ico

# Agent 工具与运行产物（不入版本库）
.pytest_cache/
.codebuddy/
**/.vite/
